{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "description": "Keep Python pinned to 3.14 for now",
      "matchManagers": ["pyenv"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
